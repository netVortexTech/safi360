# Copy to .env.local for local development. Never commit real values.
# Only VITE_-prefixed variables reach the browser bundle. Keep secrets out of them.

# Supabase project (local stack defaults shown; replace with hosted values when available)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# App
VITE_APP_ENV=development            # development | staging | production
VITE_DEFAULT_LOCALE=sw              # sw | en
VITE_TIMEZONE=Africa/Dar_es_Salaam

# Edge Functions (server-side only; set with `supabase secrets set`, never in VITE_*)
# SUPABASE_SERVICE_ROLE_KEY=
# APP_ENV=staging                   # production disables every mock adapter
# OTP_TOKEN_SECRET=                 # signs customer tokens; any long random string
# OTP_PROVIDER=mock                 # mock: fixed code 123456 (never in production); unset = 503
# PAYMENT_PROVIDER=mock             # mock adapter until Phase 5 wires Selcom / AzamPay
# MOCK_PAYMENT_SECRET=              # signs the mock callback tokens
# INTEGRATION_ENCRYPTION_KEY=       # 32-byte base64 key for tenant_integration_secrets
# WHATSAPP_APP_SECRET=
# SELCOM_API_KEY=
# SELCOM_API_SECRET=
